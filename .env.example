# SPDX-License-Identifier: Apache-2.0
# Voicy local configuration. Copy to .env and fill in secrets. Never commit .env.

TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=

# Local compose overrides this. For shared core-postgres use the voicy_core role.
DATABASE_URL=postgres://voicy:voicy@postgres:5432/voicy?sslmode=disable

HTTP_ADDR=:8080
LOG_LEVEL=info
AUTO_MIGRATE=true
MIGRATIONS_DIR=./migrations
TRANSCRIPT_RETENTION=2160h
MAX_MEDIA_BYTES=20971520
MAX_MEDIA_DURATION=1h
JOB_STALE_AFTER=30m
MAX_CONCURRENT_JOBS=4
STATS_CACHE_TTL=5m
STATS_TIMEZONE=Europe/Kyiv
