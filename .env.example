# SPDX-License-Identifier: Apache-2.0
# Copy to .env and fill in secrets. Never commit .env.

TELEGRAM_BOT_TOKEN=
DEEPGRAM_API_KEY=

# Local compose overrides this. For a shared core-postgres use the voicetotext_core role.
DATABASE_URL=postgres://voicetotext:voicetotext@postgres:5432/voicetotext?sslmode=disable

HTTP_ADDR=:8080
LOG_LEVEL=info
AUTO_MIGRATE=true
MIGRATIONS_DIR=./migrations
TRANSCRIPT_RETENTION=2160h
